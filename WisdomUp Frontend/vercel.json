{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/orders.py": {
      "includeFiles": "site/js/**",
      "maxDuration": 10
    }
  },
  "rewrites": [
    {
      "source": "/",
      "destination": "/site/index.html"
    },
    {
      "source": "/((?!api/|site/).*)",
      "destination": "/site/$1"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "demowisdomup.vercel.app"
        }
      ],
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    }
  ]
}
